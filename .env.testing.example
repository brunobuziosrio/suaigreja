# Exclusivamente para uma eventual instância Supabase LOCAL (127.0.0.1).
# Nunca copie valores da .env de desenvolvimento/produção para este arquivo.
# Os testes de isolamento atuais não leem estas variáveis.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=local-anon-key-only
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key-only

# Referência exclusiva para uma eventual caixa SMTP local (Mailpit/MailHog).
# Os testes atuais usam caixa em memória e não iniciam nem acessam este serviço.
TEST_SMTP_HOST=127.0.0.1
TEST_SMTP_PORT=1025
TEST_SMTP_FROM=nao-responda@example.test
